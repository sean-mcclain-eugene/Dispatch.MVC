    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dispatch.Worker</RootNamespace>
    <Description>Windows Worker Service that claims jobs from the shared database and runs them outside IIS.</Description>
