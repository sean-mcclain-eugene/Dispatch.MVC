<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dispatch.Web</RootNamespace>
    <Description>
      IIS / Kestrel front end. Enqueues jobs and holds the attached lease.
      It does not run the work — Dispatch.Worker does.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <ProjectReference Include="..\Dispatch.Core\Dispatch.Core.csproj" />
  </ItemGroup>

  <!-- Debug F5: refresh DispatchWorkerDebug only when worker binaries changed (no UAC otherwise). -->
  <Target Name="SyncDebugWorkerService" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' AND '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;@(MSBuildThisFileDirectory)..\scripts\install-worker-debug.ps1&quot;" />
  </Target>

</Project>
