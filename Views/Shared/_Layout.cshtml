<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Dispatch") · Dispatch MVC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Outfit:wght@360;420;520;640&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
        <a class="wordmark" asp-controller="Home" asp-action="Index">
            <span class="mark" aria-hidden="true"></span>
            Dispatch
            <small>MVC guide</small>
        </a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index">New job</a>
            <a asp-controller="Inbox" asp-action="Index">
                Inbox
                @await Component.InvokeAsync("InboxBadge")
            </a>
            <a asp-controller="Home" asp-action="Pattern">The pattern</a>
        </nav>
    </header>
    <main id="main" class="main">
        @RenderBody()
    </main>
    <footer class="foot">
        <p>
            ASP.NET Core 8 MVC guide for long jobs that start in the browser,
            convert to a <code>BackgroundService</code>, and email a session link.
        </p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
